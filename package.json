{
  "name": "iobroker.openai-toolbox",
  "version": "0.1.1",
  "description": "Create reusable OpenAI-powered tools in ioBroker",
  "keywords": [
    "iobroker",
    "openai",
    "artificial intelligence",
    "smart home",
    "automation"
  ],
  "author": "Hubobel",
  "license": "MIT",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hubobel/ioBroker.openai-toolbox.git"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": ">=22",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:package",
    "test:unit": "mocha \"test/**/*.test.js\"",
    "test:package": "mocha test/package.js --exit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "files": [
    "admin/",
    "lib/",
    "io-package.json",
    "LICENSE",
    "main.js",
    "README.md"
  ]
}
